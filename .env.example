# Local defaults. Copy to .env if you want to override them.
# Do not put production secrets in this file.

DATABASE_URL=postgresql+psycopg://rover:rover@localhost:5432/rover
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Hosted models are off unless you set this to true AND confirm each request.
HOSTED_MODEL_ENABLED=false
HOSTED_MODEL_BASE_URL=
HOSTED_MODEL_API_KEY=
HOSTED_MODEL_NAME=

# Optional colon-separated absolute paths. Empty means any local git repo is allowed.
ROVER_ALLOWED_ROOTS=
# Optional path to a workspace YAML file. ./rover.yaml is loaded automatically when present.
ROVER_CONFIG=

LOG_LEVEL=INFO
